# Safe reference template for isolated test container environment.
# NEVER commit real passwords to Git.
#
# Usage for future authorized test runs:
# 1. Generate strong, unique random passwords for container bootstrap and test runner.
# 2. Set the environment variables in your terminal session:
#    $env:GOGAA_TEST_ADMIN_PASSWORD = "your_strong_admin_bootstrap_password_here"
#    $env:GOGAA_TEST_POSTGRES_PASSWORD = "your_strong_test_runner_password_here"
# 3. Form the test connection string:
#    $env:GOGAA_TEST_POSTGRES_CONNECTION = "Host=127.0.0.1;Port=5433;Database=webapitgbot_test;Username=gogaa_test_runner;Password=$env:GOGAA_TEST_POSTGRES_PASSWORD"
# 4. Set the explicit opt-in switch:
#    $env:GOGAA_ENABLE_POSTGRES_TESTS = "true"

GOGAA_TEST_ADMIN_PASSWORD=your_strong_admin_bootstrap_password_here
GOGAA_TEST_POSTGRES_PASSWORD=your_strong_test_runner_password_here
