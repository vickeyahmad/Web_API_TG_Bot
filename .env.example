# .env.example — Safe to commit to Git.
# This file shows WHICH variables are required, but contains NO real values.
#
# To set up your local environment:
# 1. Copy this file:   copy .env.example .env
# 2. Edit .env and fill in your own passwords.
# 3. The .env file is in .gitignore and will NEVER be committed to Git.

# PostgreSQL database name (e.g. webapitgbot_db)
POSTGRES_DB=your_database_name_here

# PostgreSQL user name (e.g. webapitgbot)
POSTGRES_USER=your_username_here

# PostgreSQL password — choose something strong!
POSTGRES_PASSWORD=your_strong_password_here

# Initial Administrator Account Seed (Optional - for first-time local setup)
# Alternatively, set these using dotnet user-secrets (recommended for local dev)
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=your_strong_admin_password_here
